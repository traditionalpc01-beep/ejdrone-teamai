{
  "name": "ejdrone-teamai",
  "version": "2.0.0",
  "description": "Git-native team skills/rules sync with role-based distribution for AI coding agents",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "ejdrone": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
